{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "<chuỗi ngẫu nhiên ít nhất 32 ký tự, đặt qua dotnet user-secrets hoặc biến môi trường Jwt__Secret>",
    "Issuer": "BillSplitApi",
    "Audience": "BillSplitApp"
  },
  "CloudflareR2": {
    "AccountId": "<account id trên Cloudflare Dashboard>",
    "AccessKeyId": "<R2 Access Key ID>",
    "SecretAccessKey": "<R2 Secret Access Key>",
    "ServiceUrl": "https://<account-id>.r2.cloudflarestorage.com",
    "BucketName": "<tên bucket>",
    "PublicUrl": "https://<public-bucket-id>.r2.dev"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "<email gửi OTP>",
    "Password": "<mật khẩu ứng dụng Gmail, 16 ký tự>",
    "SenderName": "Sổ Nợ"
  }
}
